  {
   "op": "replace_global",
   "find": "</body>",
   "with": "<style>\n/* s143: the Lithium Glance mockup's sidebar and canvas, ported as the site's own components (Jonathan 2026-10-15:\n   \"the navigation, scroll behavior, size, tile style etc should be the new step2haki components from this mockup\").\n   One component (#nav.axn) replaces the layered s136 to s141 sidebar styling; its script is the s143 axnav block.\n   Values are the mockup's (index.html of Lithium_Glance.zip): brand row, search pill, systems that fold, brief tiles,\n   the nested step rail with its fill and gliding lens, the edge fade, the canvas and the top fade under the toolbar. */\n:root{\n  --axn-spr:linear(0,.022,.077,.151,.235,.322,.407,.488,.563,.63,.69,.742,.787,.826,.859,.886,.909,.928,.943,.956,.966,.974,.98,.985,.989,.992,.995,.997,.998,.999,1);\n  --axn-bnc:linear(0,.03,.104,.203,.314,.426,.533,.629,.715,.787,.847,.896,.934,.963,.984,.999,1.009,1.016,1.019,1.02,1.02,1.018,1.016,1.014,1.012,1.01,1.008,1.006,1.004,1.003,1.002,1.001,1);\n  --axn-ink:#15151B;--axn-mute:#5E5E6B;--axn-tile:rgba(255,255,255,.9);--axn-lens:rgba(255,255,255,.95);\n  --axn-trk:rgba(24,28,30,.16);--axn-hov:rgba(24,28,30,.05);--axn-fld:rgba(118,118,128,.12);--axn-canvas:#EFF0F0;\n}\n[data-theme=\"dark\"]{\n  --axn-ink:var(--ink);--axn-mute:var(--muted);--axn-tile:rgba(255,255,255,.10);--axn-lens:rgba(255,255,255,.12);\n  --axn-trk:rgba(255,255,255,.16);--axn-hov:rgba(255,255,255,.06);--axn-fld:rgba(118,118,128,.24);\n}\n\n/* ---------- the panel's head: brand row and search pill ---------- */\n#nav.axn #navtop{display:block;flex:none;padding:0;border:0;background:none}\n#nav.axn #navtop > .brand{display:none}\n#nav.axn .axn-head{display:flex;align-items:center;gap:12px;padding:18px 18px 12px}\n#nav.axn .axn-mark{width:38px;height:38px;border-radius:11px;background:#15151B;color:#FFFFFF;font:800 15px/1 var(--sans);display:flex;align-items:center;justify-content:center;flex:none}\n#nav.axn .axn-nm{font:700 17px/1.25 var(--sans);letter-spacing:-.2px;color:var(--axn-ink)}\n#nav.axn .axn-sub{font:500 12px/1.3 var(--sans);color:var(--axn-mute);margin-top:1px}\n#nav.axn .axn-tools{margin-left:auto;display:flex;align-items:center;gap:6px}\n#nav.axn .axn-cfg,#nav.axn .navclose{position:static;display:flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;margin:0;border:0;border-radius:999px;background:var(--axn-fld);color:var(--axn-ink);box-shadow:none;cursor:pointer;flex:none}\n#nav.axn .axn-cfg[aria-expanded=\"true\"]{background:var(--axn-tile);box-shadow:inset 0 0 0 1.5px rgba(var(--acc-rgb),.55)}\n@media (min-width:1101px){#nav.axn .navclose{display:none}}\n#nav.axn .axn-head > div:nth-child(2){min-width:0}\n#nav.axn .axn-sub{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n#nav.axn .axn-cfg:focus-visible,#nav.axn .navclose:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\n#nav.axn .axn-srch{display:flex;align-items:center;gap:8px;height:38px;margin:0 14px 10px;padding:0 12px;border-radius:12px;background:var(--axn-fld);box-sizing:border-box}\n#nav.axn .axn-srch:focus-within{box-shadow:inset 0 0 0 1.5px rgba(var(--acc-rgb),.55)}\n#nav.axn .axn-srch svg{flex:none}\n#nav.axn .axn-srch #search{flex:1 1 auto;min-width:0;width:auto;height:100%;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;outline:none;font:400 15px/1 var(--sans);color:var(--axn-ink);-webkit-appearance:none;appearance:none}\n#nav.axn .axn-srch #search::placeholder{color:var(--axn-mute);opacity:1}\n#nav.axn .axn-srch #search::-webkit-search-cancel-button{-webkit-appearance:none}\n\n/* ---------- the list: one scroll box with faded edges ---------- */\n#nav.axn #navscroll{padding:6px 10px 22px;-webkit-mask-image:linear-gradient(transparent,#000 14px,#000 calc(100% - 22px),transparent);mask-image:linear-gradient(transparent,#000 14px,#000 calc(100% - 22px),transparent)}\n#nav.axn #navlinks,#nav.axn #navscroll > .shelfpick,#nav.axn #navscroll > #modes{display:none!important}\n#nav.axn.sxon #axn{display:none}\n#axn .axn-sys{display:grid;grid-template-columns:14px minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;height:36px;padding:0 10px;margin:0;border:0;border-radius:11px;background:transparent;text-align:left;cursor:pointer;font-family:var(--sans);box-sizing:border-box}\n#axn .axn-sys:hover{background:var(--axn-hov)}\n#axn .axn-sys:focus-visible,#axn a:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}\n#axn .axn-sys svg{transition:transform .55s var(--axn-bnc)}\n#axn .axn-sys[aria-expanded=\"true\"] svg{transform:rotate(90deg)}\n#axn .axn-sys .nm{font-size:14px;font-weight:700;color:var(--axn-ink)}\n#axn .axn-sys .ct{font-size:12px;font-weight:600;color:var(--axn-mute)}\n#axn .axn-dz{display:grid;grid-template-rows:0fr;transition:grid-template-rows .55s var(--axn-spr)}\n#axn .axn-dz.on{grid-template-rows:1fr}\n#axn .axn-dzi{overflow:hidden;min-height:0}\n#axn .axn-dzc{opacity:0;filter:blur(6px);transform:translateY(-8px) scale(.98);transition:opacity .3s ease,filter .35s ease,transform .55s var(--axn-spr)}\n#axn .axn-dz.on .axn-dzc{opacity:1;filter:blur(0);transform:none}\n#axn .axn-dz:not(.on) .axn-dzc{visibility:hidden;transition:opacity .3s ease,filter .35s ease,transform .55s var(--axn-spr),visibility 0s .55s}\n#axn.axn-still .axn-dz,#axn.axn-still .axn-dzc,#axn.axn-still .axn-sys svg,#axn.axn-still .axn-fill,#axn.axn-still .axn-lens{transition:none!important}\n#axn .axn-lbl{font-size:12px;font-weight:600;color:var(--axn-mute);padding:10px 10px 4px 32px}\n#axn a.axn-b{display:flex;align-items:center;min-height:34px;padding:6px 10px 6px 32px;box-sizing:border-box;border-radius:11px;font-size:14px;line-height:19px;font-weight:500;color:var(--axn-ink);text-decoration:none}\n#axn a.axn-b:hover{background:var(--axn-hov)}\n#axn a.axn-b[aria-current=\"page\"]{background:var(--axn-tile);box-shadow:0 1px 3px rgba(0,0,0,.10),inset 0 0 0 1px rgba(24,28,30,.10);font-weight:700}\n#axn [hidden]{display:none!important}\n\n/* ---------- the current brief's step rail ---------- */\n#axn .axn-rail{display:grid;grid-template-columns:4px minmax(0,1fr);gap:8px;padding:6px 0 8px 34px}\n#axn .axn-trk{position:relative;border-radius:4px;background:var(--axn-trk)}\n#axn .axn-fill{position:absolute;left:0;right:0;top:0;height:34px;border-radius:4px;background:var(--accent);box-shadow:0 0 8px rgba(var(--acc-rgb),.55);transition:height .55s var(--axn-spr)}\n#axn .axn-rows{position:relative}\n#axn .axn-lens{position:absolute;left:0;right:0;top:0;height:34px;border-radius:11px;background:var(--axn-lens);box-shadow:inset 0 0 0 1.5px rgba(var(--acc-rgb),.55),0 4px 16px rgba(var(--acc-rgb),.24);transition:transform .7s var(--axn-bnc);pointer-events:none}\n#axn .axn-rl{position:relative;display:flex;flex-direction:column;gap:2px}\n#axn a.axn-s{display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:4px;height:34px;padding:0 10px;border-radius:11px;color:var(--axn-ink);text-decoration:none;cursor:pointer}\n#axn a.axn-s .n{font-size:12px;font-weight:700;color:var(--axn-mute);transition:color .3s ease}\n#axn a.axn-s .l{font-size:14px;font-weight:500}\n#axn a.axn-s .u{font-size:11px;font-weight:500;color:var(--axn-mute)}\n#axn a.axn-s[aria-current=\"step\"] .n{color:var(--accent)}\n#axn a.axn-s[aria-current=\"step\"] .l{font-weight:700}\n#axn a.axn-s[aria-disabled=\"true\"]{opacity:.5;cursor:default}\n@media (prefers-reduced-motion:reduce){\n  #axn .axn-dz,#axn .axn-dzc,#axn .axn-sys svg,#axn .axn-fill,#axn .axn-lens{transition:none!important}\n}\n\n/* ---------- the display sheet: the switches the mockup's sidebar does not carry ---------- */\n#nav.axn{position:fixed}\n#axdisp{position:absolute;top:70px;left:10px;right:10px;z-index:6;max-height:calc(100% - 78px);overflow-y:auto;box-sizing:border-box;padding:8px;border-radius:22px;\n  background:rgba(250,250,252,.92);-webkit-backdrop-filter:blur(40px) saturate(190%);backdrop-filter:blur(40px) saturate(190%);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 0 0 .5px rgba(0,0,0,.08),0 18px 48px rgba(0,0,0,.16);\n  opacity:0;transform:translateY(-6px) scale(.98);transform-origin:top right;pointer-events:none;visibility:hidden;\n  transition:opacity .25s ease,transform .45s var(--axn-spr),visibility 0s .45s}\n#axdisp:focus{outline:none}\n#axdisp.on{opacity:1;transform:none;pointer-events:auto;visibility:visible;transition:opacity .25s ease,transform .45s var(--axn-spr)}\n[data-theme=\"dark\"] #axdisp{background:rgba(40,40,46,.92);box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 0 0 .5px rgba(255,255,255,.10),0 18px 48px rgba(0,0,0,.5)}\n#axdisp .axd-h{font:650 13px/1.2 var(--sans);color:var(--axn-mute);padding:10px 12px 6px}\n#axdisp .shelfpick{display:flex!important;flex-direction:row!important;align-items:center;justify-content:space-between;gap:10px;margin:0;padding:4px 12px 8px;border:0;background:none;box-shadow:none;text-align:left}\n#axdisp .shelfpick .lbl{font:600 14px/1.2 var(--sans);color:var(--axn-ink);letter-spacing:0;text-transform:none}\n#axdisp .shelfpick select{width:auto;max-width:60%;height:34px;margin:0;font:600 14px/1.2 var(--sans);color:var(--axn-ink);background-color:var(--axn-fld);border:0!important;outline:none;box-shadow:none!important;border-radius:10px;padding:0 10px}\n#axdisp .shelfpick select:focus-visible{box-shadow:inset 0 0 0 1.5px rgba(var(--acc-rgb),.55)!important}\n#axdisp #modes{display:flex;flex-direction:column;gap:2px;margin:0;padding:0;border:0;background:none}\n#axdisp #modes button{all:unset;display:flex;flex-direction:row-reverse;align-items:center;justify-content:space-between;gap:10px;box-sizing:border-box;width:100%;min-height:42px;padding:0 12px;border-radius:12px;cursor:pointer;background:transparent;box-shadow:none}\n#axdisp #modes button:hover{background:var(--axn-hov)}\n#axdisp #modes button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}\n#axdisp #modes .nm{font:600 14px/1.2 var(--sans);letter-spacing:0;text-transform:none;color:var(--axn-ink)}\n#axdisp #modes .track{width:42px;height:26px;border-radius:999px;background:rgba(120,120,128,.24);position:relative;flex:none;box-shadow:none;transition:background .25s ease}\n#axdisp #modes .knob{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:#FFFFFF;box-shadow:0 2px 6px rgba(0,0,0,.18);transition:transform .45s var(--axn-bnc)}\n#axdisp #modes button[aria-pressed=\"true\"] .track{background:var(--accent)}\n#axdisp #modes button[aria-pressed=\"true\"] .knob{transform:translateX(16px)}\n#axdisp #modes .axacc{display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:10px 12px 8px;margin:0;border:0;background:none}\n#axdisp #modes .axacc .nm{width:100%}\n#axdisp #modes .axacc .axsw{all:unset;width:22px;height:22px;border-radius:999px;background:var(--sw);box-shadow:0 0 0 1px rgba(24,28,30,.15);cursor:pointer}\n#axdisp #modes .axacc .axsw[aria-checked=\"true\"]{box-shadow:0 0 0 2px #FFFFFF,0 0 0 4px var(--sw)}\n#axdisp #modes .axacc .axsw:focus-visible{outline:2px solid var(--accent);outline-offset:3px}\n#axdisp #modes .axacc .axan{font:700 13px/1 var(--sans);color:var(--axn-ink);margin-left:2px}\n#axdisp .axbuild{display:block;margin:4px 0 0;padding:10px 12px 8px;border-top:1px solid rgba(24,28,30,.08);font:500 12px/1.3 var(--sans);color:var(--axn-mute)}\n[data-theme=\"dark\"] #axdisp .axbuild{border-top-color:rgba(255,255,255,.10)}\n\n/* ---------- canvas: the brief sits on the page, not on a slab ---------- */\nhtml:not([data-theme=\"dark\"]) body{background:linear-gradient(180deg,#EFF0F0 0%,#E9EBEB 100%) fixed;background-color:#EFF0F0}\nmain .wrap > .brief{background:none!important;box-shadow:none!important;border-radius:0!important;border:0!important}\n@media (min-width:1101px){\n  main{margin-left:0}\n  main .wrap{box-sizing:content-box;max-width:1040px;margin:0 auto;padding:0 40px 0 384px}\n  main .wrap > .brief{padding:104px 0 0!important;margin:0 0 96px;scroll-margin-top:0}\n  #axtopfade{position:fixed;top:0;left:0;right:0;height:88px;z-index:30;pointer-events:none;\n    background:linear-gradient(rgba(239,240,240,.9),rgba(239,240,240,0));-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);\n    -webkit-mask-image:linear-gradient(#000 45%,transparent);mask-image:linear-gradient(#000 45%,transparent)}\n  [data-theme=\"dark\"] #axtopfade{display:none}\n}\n@media (max-width:1100px){\n  #axtopfade{display:none}\n  main .wrap > .brief{padding:64px 0 0!important;margin:0 0 72px}\n}\n</style>\n<script>\n/* s143: the Lithium Glance mockup's sidebar as one component (Jonathan 2026-10-15). Presentation only: no text is\n   invented. The old #navlinks list stays in the page, hidden, because the shelf, Board-style only and search scripts\n   write their filters onto it; this list mirrors its visibility and counts and draws the mockup's parts:\n   systems that fold (chevron, name, count), brief tiles, and under the current brief its step rail with the fill and\n   one lens that glides between steps. A step is current once its heading passes 32% of the window (the mockup's\n   rule); a click on a step takes effect at once and the spy waits 0.9 s. The list keeps the current step in view.\n   The switches the mockup's sidebar does not carry (shelf, Board-style only, Recall, themes, accent, the change log)\n   move into a display sheet behind the round button in the brand row. */\n(function(){\n  \"use strict\";\n  var nav = document.getElementById('nav'), old = document.getElementById('navlinks');\n  if(!nav || !old) return;\n  window.AXN = 1;\n  var WIDE = window.matchMedia('(min-width:1101px)');\n  var SVG_CHEV = '<svg width=\"8\" height=\"12\" viewBox=\"0 0 9 14\" aria-hidden=\"true\"><path d=\"M2 2l5 5-5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>';\n  var SVG_SRCH = '<svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"></circle><path d=\"M11 11l3.5 3.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"></path></svg>';\n  var SVG_CFG = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 4.5h7M12 4.5h2M2 11.5h2M7 11.5h7\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/><circle cx=\"10.5\" cy=\"4.5\" r=\"1.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"5.5\" cy=\"11.5\" r=\"1.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg>';\n  function el(tag, cls, html){ var e = document.createElement(tag); if(cls) e.className = cls; if(html != null) e.innerHTML = html; return e; }\n  function txt(n){ return (n.textContent || '').replace(/\\s+/g, ' ').trim(); }\n  function shown(n){ return n && n.style.display !== 'none' && !n.hidden; }\n\n  /* ---------- head: brand row, display button, search pill ---------- */\n  function head(){\n    var top = document.getElementById('navtop'), brand = nav.querySelector('.brand'), search = document.getElementById('search');\n    if(!top) return;\n    var h = el('div', 'axn-head');\n    var name = brand && brand.querySelector('h1') ? txt(brand.querySelector('h1')) : 'Step2Haki';\n    var sub = brand ? Array.prototype.filter.call(brand.querySelectorAll('p'), function(p){ return !p.classList.contains('axbuild'); })[0] : null;\n    h.appendChild(el('div', 'axn-mark', 'S2'));\n    var t = el('div'); t.appendChild(el('div', 'axn-nm')).textContent = name;\n    t.appendChild(el('div', 'axn-sub')).textContent = sub ? txt(sub) : '';\n    h.appendChild(t);\n    var tools = el('div', 'axn-tools');\n    var cfg = el('button', 'axn-cfg', SVG_CFG); cfg.type = 'button'; cfg.id = 'axcfg';\n    cfg.setAttribute('aria-label', 'Display settings'); cfg.setAttribute('aria-expanded', 'false'); cfg.setAttribute('aria-controls', 'axdisp');\n    tools.appendChild(cfg);\n    var x = top.querySelector('.navclose'); if(x) tools.appendChild(x);\n    h.appendChild(tools);\n    top.insertBefore(h, top.firstChild);\n    if(search){\n      var pill = el('div', 'axn-srch', SVG_SRCH);\n      top.insertBefore(pill, search); pill.appendChild(search);\n      var ph = function(){ search.setAttribute('placeholder', 'Search topics, findings, drugs'); };\n      ph(); window.addEventListener('load', ph);\n      new MutationObserver(function(){ if(search.getAttribute('placeholder') !== 'Search topics, findings, drugs') ph(); }).observe(search, {attributes: true, attributeFilter: ['placeholder']});\n    }\n    sheet(cfg, brand);\n  }\n\n  /* ---------- the display sheet ---------- */\n  function sheet(btn, brand){\n    var s = el('div'); s.id = 'axdisp'; s.setAttribute('role', 'dialog'); s.setAttribute('aria-label', 'Display settings'); s.tabIndex = -1;\n    s.appendChild(el('div', 'axd-h')).textContent = 'Display';\n    nav.appendChild(s);\n    function fill(){\n      var sp = nav.querySelector('#navscroll > .shelfpick'), md = document.getElementById('modes');\n      if(sp && sp.parentNode !== s) s.appendChild(sp);\n      if(md && md.parentNode !== s) s.appendChild(md);\n      var b = brand && brand.querySelector('.axbuild'); if(b && b.parentNode !== s) s.appendChild(b);\n      // the switches' labels read as sentences here, like the rest of the sheet (presentation only)\n      s.querySelectorAll('#modes .nm').forEach(function(n){ var t = n.textContent; if(t && t === t.toUpperCase()) n.textContent = t.charAt(0) + t.slice(1).toLowerCase(); });\n    }\n    fill(); window.addEventListener('load', fill);\n    function set(on){\n      s.classList.toggle('on', on); btn.setAttribute('aria-expanded', on ? 'true' : 'false');\n      if(on){ fill(); try{ s.focus({preventScroll: true}); }catch(e){} }\n    }\n    btn.addEventListener('click', function(e){ e.stopPropagation(); set(!s.classList.contains('on')); });\n    document.addEventListener('click', function(e){ if(s.classList.contains('on') && !s.contains(e.target) && e.target !== btn) set(false); });\n    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && s.classList.contains('on')){ e.stopPropagation(); set(false); try{ btn.focus(); }catch(x){} } }, true);\n    // the change log button lives in the sheet now; opening the log closes the sheet\n    s.addEventListener('click', function(e){ if(e.target.closest && e.target.closest('.axlogbtn')) set(false); });\n  }\n\n  /* ---------- list ---------- */\n  var list, groups = [], byId = {}, cur = {brief: null, step: -1}, rail = null, lock = 0, open = {};\n  function build(){\n    var host = document.getElementById('navscroll') || old.parentNode;\n    list = el('div'); list.id = 'axn'; list.setAttribute('role', 'navigation'); list.setAttribute('aria-label', 'All briefs');\n    host.insertBefore(list, old);\n    var g = null, box = null;\n    Array.prototype.slice.call(old.children).forEach(function(n){\n      if(n.classList.contains('sect')){\n        var ct = n.querySelector('.count'), name = txt(n).replace(ct ? txt(ct) : '', '').trim();\n        var b = el('button', 'axn-sys', SVG_CHEV + '<span class=\"nm\"></span><span class=\"ct\"></span>'); b.type = 'button';\n        b.querySelector('.nm').textContent = name; b.querySelector('.ct').textContent = ct ? txt(ct) : '';\n        var dz = el('div', 'axn-dz'), dzi = el('div', 'axn-dzi'); box = el('div', 'axn-dzc');\n        dzi.appendChild(box); dz.appendChild(dzi); list.appendChild(b); list.appendChild(dz);\n        g = {src: n, cnt: ct, btn: b, dz: dz, items: [], name: name};\n        groups.push(g);\n        b.addEventListener('click', function(gg){ return function(){ fold(gg, gg.btn.getAttribute('aria-expanded') !== 'true', true); }; }(g));\n        fold(g, false, false);\n      } else if(g && n.classList.contains('navsub')){\n        var l = el('div', 'axn-lbl'); l.textContent = txt(n); box.appendChild(l); g.items.push({src: n, el: l});\n      } else if(g && n.tagName === 'A' &&